# ==============================================================================
# SocietySync — Local Environment Configuration Template
# Copy this file to .env or set these environment variables in your terminal/IDE.
# DO NOT COMMIT REAL PASSWORDS OR SENSITIVE SECRETS.
# ==============================================================================

# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=societysync
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password_here

# Full DataSource URL override (optional)
# DB_URL=jdbc:mysql://localhost:3306/societysync?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Server Port
PORT=8080
