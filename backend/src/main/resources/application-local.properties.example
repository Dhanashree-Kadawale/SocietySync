# ==============================================================================
# SocietySync — Local Development Properties Template
# Copy this file to application-local.properties for personalized local testing.
# application-local.properties is ignored by git to protect credentials.
# ==============================================================================

# Local Database Credentials
spring.datasource.url=jdbc:mysql://localhost:3306/societysync?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
spring.datasource.username=root
spring.datasource.password=your_local_mysql_password_here

# Enable detailed SQL logs during local troubleshooting
spring.jpa.show-sql=true
